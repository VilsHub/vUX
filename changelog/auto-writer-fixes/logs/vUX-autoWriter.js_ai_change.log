NEW_SECTION
var callBackDelay = 0, typingSpeed = [10, 20], cursorBlinkDelay = 300,
cursorStyle = {style:"solid", width:"1px", color:"green"}, showCursor = false,
timers = {write:null, blink:null, erase:null, directive:null},
boxes = null, texts = null, boxIndex = 0, conE = null, currentText = "", cursorIndex = 0;

...

function clearMemory(){
    clearTimeout(timers.write);
    clearInterval(timers.blink);
    clearInterval(timers.erase);
    clearInterval(timers.directive);
    timers.write = timers.blink = timers.erase = timers.directive = null;
}

...

function startBox(){
    addSpan(boxes[boxIndex]);
    conE = boxes[boxIndex].querySelector(".vAutoWriter");
    currentText = texts[boxIndex];
    cursorIndex = 0;
}
function endBox(fn){
    doneWriting();
    boxIndex++;
    if (boxIndex < boxes.length){ //group: move on to the next element
        startBox();
        step(fn);
    }else{
        reset();
        runCallBack(fn);
    }
}
function reset(){
    clearMemory();
    boxes = null;
    texts = null;
    boxIndex = 0;
    conE = null;
    currentText = "";
    cursorIndex = 0;
}

...

this.stop = function() {
    reset();
}

REASON
Single mode set PlainTextCounter to -1 on completion and never cleared 'init' or 'conE',
so the instance could not be used twice. The second call kept the first call's container
and text, read currentText[-1] (undefined) and wrote it out, then retyped the OLD string.
Measured before the fix, writeText(box1,"First") followed by writeText(box2,"Second")
left box1 holding "FirstundefinedFirst" and never created a span in box2 at all. State is
now reset on completion and rebuilt at the start of every run, and the single/group
distinction collapses into one list of boxes with one list of texts, removing the
mainTextBox/mainTexts/familyN/family/init/PlainTextCounter tangle.
clearMemory() previously cleared only the typing timeout, leaking the blink interval and
the deletion interval whenever an instance was discarded mid-animation; it now clears all
four slots. this.stop() is added because there was no way to cancel a run in progress —
necessary for a component torn down while typing, e.g. on an SPA route change.

