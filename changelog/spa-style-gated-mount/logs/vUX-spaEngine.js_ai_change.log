        styleTimeout: {
            set: function(value){
                //How long, in ms, a fragment waits for its stylesheets before it is mounted anyway.
                //0 mounts as soon as the HTML is in, without waiting.
                if (typeof value != "number" || !isFinite(value) || value < 0) {
                    throw new TypeError("config.styleTimeout property value must be a finite number of milliseconds, 0 or more");
                }
                styleTimeout = value;
            },
            get: function(){
                return styleTimeout;
            }
        }
    })

REASON
New config.styleTimeout property: the most a fragment waits for its stylesheets before it is mounted anyway (default 3000ms, 0 = no wait). Validated as a finite number >= 0.

