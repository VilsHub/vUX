FILE: vUX-modalDisplayer.js
FEATURE: modal-stacking
DATE: 2026-08-03
PRIOR STATE: as left by feature 'modal-displayer-verification'

The module was restructured rather than patched, so the sections below are grouped
by the concern that changed. The starting point is the post-verification file, in
which all state lived in single closure variables and one overlay was built at
initialize() time.

================================================================================
CHANGE 1 — Replace single-modal closure state with a shared layer stack
================================================================================

OLD_SECTION
export function ModalDisplayer() {
    var self = this,cssWidth = "",exitOnAway=true,currentForm = null,id = null,effectName = "none",bodyOldPosition = "",mainFormCon = "",mainFormConInner = "",overlayBackgroundType = "color",overlayStyle= "hsla(0, 0%, 100%, 0.48)",initialized = false,openProcessor = function() {},closeProcessor = function() {},modalOn = false,sY = 0,computedModalHeight = 0,computedModalWidth = 0;
    var defaultModalWidths = ["500px", "500px", "86%"],modalWidths = defaultModalWidths, brkpoints = { largeStart: 1000, mediumStart: 520 },pageContainer = null,className = "",formIdAttribute = "",closeButtonClass = "",modalWidthsAttribute = "";

NEW_SECTION
//Open modals are held in one stack shared by every ModalDisplayer instance, so a
//modal opened from inside a displayed modal nests on top of it instead of
//overwriting it. The stack has to be shared rather than per instance because the
//state it guards - the body freeze and the page scroll position - belongs to the
//document, not to an instance: it is captured when the stack becomes non empty and
//released only when it empties again.
var modalStack = [];
var pageState = { scrollY: 0, bodyPosition: "", frozen: false };
var globalHandlersAttached = false;

function topLayer() {
    return modalStack.length > 0 ? modalStack[modalStack.length - 1] : null;
}

function layerOf(node) {
    for (var x = modalStack.length - 1; x >= 0; x--) {
        if (modalStack[x].overlay.contains(node)) return modalStack[x];
    }
    return null;
}

export function ModalDisplayer() {
    var self = this,initialized = false,effectName = "none",exitOnAway = true,overlayBackgroundType = "color",overlayStyle = "hsla(0, 0%, 100%, 0.48)",openProcessor = function() {},closeProcessor = function() {},pageContainer = null;
    var defaultModalWidths = ["500px", "500px", "86%"],modalWidths = defaultModalWidths,brkpoints = { largeStart: 1000, mediumStart: 520 },className = "",formIdAttribute = "",closeButtonClass = "",modalWidthsAttribute = "";

REASON
This is the root of the change. Every piece of per-modal state was a single closure
variable (currentForm, id, cssWidth, mainFormCon, mainFormConInner,
computedModalHeight/Width, modalOn, sY, bodyOldPosition). Opening a second modal
overwrote all of them, which is why nesting silently destroyed the first modal:
its stored innerHTML, id and class were replaced by the second modal's before the
first was ever restored.

Those variables become fields on a layer object, and layers live in an array. All
per-modal values are now read from a layer, so opening N modals keeps N independent
sets of state.

The stack is module scoped, not instance scoped, deliberately. Two ModalDisplayer
instances on one page share a single document body and a single scroll position;
with a stack per instance each would independently freeze and unfreeze the body,
reintroducing the exact bug this change fixes. Instance-specific configuration is
snapshotted onto the layer at open time instead (see CHANGE 4), so each layer still
behaves according to the instance that opened it.

Config variables that remain per instance are unchanged; only the runtime state moved.

================================================================================
CHANGE 2 — One overlay per layer, created on open, instead of one built at init
================================================================================

OLD_SECTION
    function createElements() {
        if ($$.ss("div[data-id='vModalStyles']") == null) {
            //Create
            var overlay = $$.ce("DIV");
            var effectsCon = $$.ce("DIV");

            //Set attributes
            overlay.classList.add("vModal", "xScroll");
            overlay.setAttribute("data-id", "vModalStyles");

            if (overlayBackgroundType == "color") {
                if (overlayStyle != "") overlay.style["background"] = overlayStyle;
            }

            effectsCon.classList.add("modalSpace");

            //Append modal
            //modalSpace to overlay
            overlay.appendChild(effectsCon);

            //Modal to document
            document.body.appendChild(overlay);
        }
    };

NEW_SECTION
    var overlay = $$.ce("DIV");
    overlay.classList.add("vModal", "xScroll");
    overlay.style["z-index"] = 999 + modalStack.length; //each layer sits above the one it was opened from
    if (layer.overlayBackgroundType == "color" && layer.overlayStyle != "") {
        overlay.style["background"] = layer.overlayStyle;
    }

    var space = $$.ce("DIV");
    space.classList.add("modalSpace");

    var host = $$.ce("DIV");
    host.classList.add("vModalHost");

    if (modalStack.length == 0) { //keep the pre stacking markers on the first layer, for existing selectors
        overlay.setAttribute("data-id", "vModalStyles");
        host.setAttribute("id", "newModal");
    }

    space.appendChild(host);
    overlay.appendChild(space);
    document.body.appendChild(overlay);

REASON
A single shared overlay cannot represent two modals: it has one backdrop, one scroll
container and one z-index. Overlays are therefore built per layer inside openLayer()
and removed when that layer closes, and createElements() is deleted along with its
call from initialize().

Each overlay gets an explicit z-index of 999 + depth so layers paint in stack order,
and each is its own scroll container, so a tall modal at layer 2 scrolls
independently of layer 1.

Backward compatibility is preserved for the common single-modal case: the first
layer still carries data-id="vModalStyles" on the overlay and id="newModal" on the
content host, so consumer CSS or scripts written against the older DOM keep working.
Layers above the first deliberately omit them, because duplicate ids are what broke
nesting in the first place.

Consequence to be aware of: no overlay exists in the DOM until the first modal is
opened. Previously one sat in the document from initialize() onwards.

================================================================================
CHANGE 3 — Address DOM nodes by reference instead of by shared id
================================================================================

OLD_SECTION
    this.close = function() {
        if (modalOn == true) {
            var modalParent = $$.ss(".vModal");
            var OldModal = $$.ss("#vOld");
            var currentModal = modalParent.querySelector("#newModal").childNodes[0];
            currentForm = null;
            id = null;
            closeEffect[effectName](OldModal, currentModal);
        }
    };
    function resetOldModalProperties(oldModal, currentModal) {
        oldModal.setAttribute("id", currentModal.id);
        oldModal.setAttribute("class", (currentModal.getAttribute("class")));
        oldModal.style["display"] = "none";
        oldModal.style["width"] = cssWidth;
        oldModal.innerHTML = mainFormConInner;
    }

NEW_SECTION
    this.close = function() {
        closeTopLayer();
    };

function closeTopLayer() {
    var layer = topLayer();
    if (layer == null || layer.closing) return;
    layer.closing = true;
    closeEffects[layer.effect](layer);
}

function restoreSource(layer) {
    var source = layer.source;
    if (layer.sourceId != null) source.setAttribute("id", layer.sourceId);
    if (layer.sourceClass != null) {
        source.setAttribute("class", layer.sourceClass);
    } else {
        source.removeAttribute("class");
    }
    source.innerHTML = layer.sourceInner;
    source.style["display"] = "none";
    source.style["width"] = layer.sourceInlineWidth;
}

REASON
The old code found everything by global id: $$.ss("#vOld") for the original element,
"#newModal" for the displayed copy, "#effectsCon"/"#eleft"/"#eright"/"#flipper"/
"#flpform"/"#fBG"/"#Boxform" for the animation boxes. With two modals open every one
of those ids existed twice and querySelector returned whichever came first in
document order — so close() restored the wrong element's id, class and innerHTML
onto the wrong node, permanently destroying the first modal.

Ids are no longer used for internal wiring at all. Each layer holds direct
references (overlay, space, host, effectsCon, source) and the animation boxes are
found by class, scoped to that layer's own effects container. Nothing is looked up
globally, so nothing can collide.

Two further details this enables. resetOldModalProperties() used to reconstruct the
original element's identity from the *displayed copy*, which is what made the
cross-contamination possible; restoreSource() now replays values captured from the
source itself at open time. And the restored width is the source's original inline
width rather than its computed width, so closing no longer bakes a pixel value onto
an element that had none.

Related: the copies placed in animation boxes now have their id stripped
(fillEffectBox), leaving the id only on the single copy in the layer host. That
keeps document.getElementById(<modal id>) resolving to the element the user can
actually see, while removing the transient duplicate ids the split and flip effects
used to create.

================================================================================
CHANGE 4 — Per-layer configuration snapshot
================================================================================

OLD_SECTION
    function show(modal) {
        if (!initialized) throw new Error("Please initialize using the 'initialize()' method, before triggering modal");
        sY = scrollY;
        currentForm = modal;
        modal.id != null ? id = modal.id : null;
        var modalDimension = getDimensionOfHidden(modal);
        computedModalHeight = modalDimension["height"];
        computedModalWidth = modalDimension["width"];
        cssWidth = $$.sm(modal).cssStyle("width");

        if (effectName == "split") {
            modal.style["width"] = computedModalWidth + "px";
        } else {
            modal.style["width"] = "100%";
        }

        //effect call
        effects[effectName](modal);
        if (overlayBackgroundType == "blur" && pageContainer != null) pageContainer.classList.add("vxKit");
    };

NEW_SECTION
    function show(modal) {
        if (!initialized) throw new Error("Please initialize using the 'initialize()' method, before triggering modal");
        for (var x = 0; x < modalStack.length; x++) { //a modal cannot be stacked on itself
            if (modalStack[x].source === modal) return;
        }
        openLayer({
            owner: self,
            effect: effectName,
            widths: modalWidths,
            brkpoints: brkpoints,
            exitOnAway: exitOnAway,
            closeButtonClass: closeButtonClass,
            openProcessor: openProcessor,
            closeProcessor: closeProcessor,
            overlayBackgroundType: overlayBackgroundType,
            overlayStyle: overlayStyle,
            pageContainer: pageContainer
        }, modal);
    }

REASON
Effect, widths, callbacks and close behaviour were read from instance variables at
the moment they were needed — which, for a close handler, could be long after the
modal opened and after config had been changed for a different modal. With layers
they must be fixed per layer, or closing modal A would use the settings that were
current when modal B opened.

show() therefore snapshots the instance's configuration into the layer. A layer
closes with the same effect it opened with, fires the callbacks belonging to the
instance that opened it, and honours that instance's exitOnAway and
closeButtonClass, even while a modal from another instance sits on top of it.

The self-stacking guard is new: opening a modal that is already on the stack would
blank its source a second time and lose the content permanently, so it is refused.

================================================================================
CHANGE 5 — Page freeze and scroll capture moved to the stack boundary
================================================================================

OLD_SECTION
        if (modalOn == true) {
            bodyOldPosition = $$.sm("body").cssStyle("position");
            document.body.style["position"] = "fixed";
            document.body.style["top"] = "-" + sY + "px";
        }

NEW_SECTION
function freezePage() {
    if (pageState.frozen) return; //only the bottom layer freezes; nested opens must not re-capture
    pageState.scrollY = window.scrollY;
    pageState.bodyPosition = document.body.style["position"];
    document.body.style["position"] = "fixed";
    document.body.style["top"] = "-" + pageState.scrollY + "px";
    pageState.frozen = true;
}

function releasePage() {
    if (!pageState.frozen) return;
    document.body.style["position"] = pageState.bodyPosition;
    document.body.style["top"] = "";
    pageState.frozen = false;

    //jump back instantly, then leave the page's own scroll-behavior as it was
    var htmlEle = $$.ss("html");
    var previousScrollBehavior = htmlEle.style["scroll-behavior"];
    htmlEle.style["scroll-behavior"] = "auto";
    scrollTo(0, pageState.scrollY);
    htmlEle.style["scroll-behavior"] = previousScrollBehavior;
}

REASON
This block was the direct cause of the permanent page freeze reported when opening a
modal from inside another. It captured bodyOldPosition from the *computed* body
position every time a modal opened. On the first open the body was still static, so
"static" was saved correctly. On a nested open the body was already "fixed", so
"fixed" was saved — and closing then faithfully restored the page to frozen, leaving
it unscrollable for the rest of its life.

Freezing is now a property of the stack, not of a modal: freezePage() captures the
scroll position and body position only when the stack is empty and is a no-op
otherwise, and releasePage() runs only when the last layer closes. Nesting therefore
cannot re-capture, and the scroll position recorded belongs to the moment the user
was last actually looking at the page.

Two smaller corrections included here. The captured value is now the *inline* style
rather than the computed one, so a page with no inline position is restored to none
instead of having position:static written onto it. And the top offset is cleared
rather than set to "0", for the same reason.

