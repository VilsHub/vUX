        handlePopState = function(e){
            //a save still pending belongs to the entry being left, and history.state is already the
            //new entry, so it is dropped rather than written into the wrong one
            clearTimeout(scrollSaveTimer);

            if(e.state != null){

                let parsedData          = JSON.parse(e.state);
                let savedScroll         = typeof parsedData.scrollY == "number" ? parsedData.scrollY : null;
                let routeProperties     = parsedData.routeProperties;
                let routeName           = routeProperties.name;

REASON
startRouter() takes scroll restoration over from the browser (scrollRestoration = manual: the browser would restore against the old content before the entry's content is mounted) and saves the position into the current entry, debounced to 100ms. The popstate handler drops a pending save (history.state is already the new entry, so it would be written into the wrong one) and takes the new entry's saved scrollY from the state it already parsed.

