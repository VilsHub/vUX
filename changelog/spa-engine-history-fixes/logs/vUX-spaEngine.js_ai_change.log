    function readEngineState(state){
        //The engine's own data in a history entry, or null for an entry it did not write (no state,
        //another script's state, or a route that is no longer configured)
        if (typeof state != "string") return null;
        try {
            let data = JSON.parse(state);
            if (data == null || data.routeProperties == undefined || data.contents == undefined) return null;
            if (routeConfigs.routes[data.routeProperties.name] == undefined) return null;
            return data;
        } catch (error) {
            return null;
        }
    }

    function isEngineShaped(state){
        //Written by the engine (by its shape), whatever route it names
        if (typeof state != "string") return false;
        try {
            let data = JSON.parse(state);
            return data != null && data.routeProperties != undefined && data.contents != undefined;
        } catch (error) {
            return false;
        }
