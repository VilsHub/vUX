/***************************TimeLine List*****************************/
export function TimeLineList(){
    var className ="", destroyed = false;
    var activatedLists = [];   //every <ul> this instance marked, so destroy() can unmark them again
    var dataAttributes = {
        timeLineBorderStyleAttrib:"",

