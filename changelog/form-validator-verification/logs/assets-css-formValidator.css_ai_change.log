/* Message text: transparent while the box grows (.vShown is added when it has), then coloured
   from the form's own custom properties, so two forms on a page keep their own colours */
.vMsgBox.vShown.error { color: var(--error-color); }
.vMsgBox.vShown.warning { color: var(--warning-color); }
.vMsgBox.vShown.success { color: var(--success-color); }
.vMsgBox.clear { color: transparent; }

/* The form loader is in the overlay from initialize(); it shows only while a request is pending */
.vFormLoaderHide { display: none !important; }

/* The loader's own ring, used when config.progressIndicatorStyle is not set */
.vFormLoader.vDefaultSpinner::before {
    content: '';
    box-sizing: border-box;
    border: 4px solid rgba(0, 0, 0, .15);
    border-top-color: rgba(0, 0, 0, .65);
    border-radius: 50%;
}

/* a message under the field wraps instead of running off a narrow screen */
.vBottom { white-space: normal; max-width: 100%; }

REASON
Message colour moved into CSS per type (.vShown, .clear) so each form uses its own custom properties; hidden-loader class; default ring spinner; readable warning/success palette; bottom messages wrap.
